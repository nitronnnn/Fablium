# Dunst — ~/.config/dunst/dunstrc
# Цвета лежат в dunstrc.d/99-colors.conf (генерируются theme.sh)

[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = 12x12
    width = 350
    height = 120
    notification_limit = 5

    corner_radius = 10
    frame_width = 2
    gap_size = 6
    padding = 12
    horizontal_padding = 12

    font = JetBrainsMono Nerd Font 11
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left

    icon_position = left
    max_icon_size = 48

    sort = yes
    idle_threshold = 120
    show_age_threshold = 60
    stack_duplicates = true

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    timeout = 0
